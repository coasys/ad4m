      "types": "./pkg/identity.d.ts",
      "import": "./pkg/identity.js",
      "default": "./pkg/identity.js"
    },
    "./identity_bg.wasm": "./pkg/identity_bg.wasm"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coasys/ad4m.git",
    "directory": "identity-wasm"
  },
  "version": "0.13.1-staging.16"
