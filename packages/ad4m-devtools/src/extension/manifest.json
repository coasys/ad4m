{
  "manifest_version": 3,
  "name": "AD4M DevTools",
  "version": "0.1.0",
  "description": "Chrome DevTools panel for debugging AD4M applications",
  "devtools_page": "devtools.html",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}