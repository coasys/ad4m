    {"path": "ad4m://agent_session/about",       "name": "about",      "min_count": 0, "max_count": 1, "setter": [{"action": "setSingleTarget", "source": "this", "predicate": "ad4m://agent_session/about", "target": "value"}]},
    {"path": "ad4m://agent_session/work_in",     "name": "workIn",     "min_count": 0, "max_count": 1, "local": true, "setter": [{"action": "setSingleTarget", "source": "this", "predicate": "ad4m://agent_session/work_in", "target": "value"}]},
    {"path": "ad4m://agent_session/library",     "name": "library",    "min_count": 0, "max_count": 1, "local": true, "setter": [{"action": "setSingleTarget", "source": "this", "predicate": "ad4m://agent_session/library", "target": "value"}]},
    {"path": "ad4m://agent_session/write_tools", "name": "writeTools", "min_count": 0, "max_count": 1, "local": true, "setter": [{"action": "setSingleTarget", "source": "this", "predicate": "ad4m://agent_session/write_tools", "target": "value"}]},
    {"path": "ad4m://agent_session/model",       "name": "model",      "min_count": 0, "max_count": 1, "local": true, "setter": [{"action": "setSingleTarget", "source": "this", "predicate": "ad4m://agent_session/model", "target": "value"}]}
  ]
