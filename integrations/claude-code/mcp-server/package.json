{
  "name": "ad4m-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for AD4M — gives Claude Code agents read/write access to the AD4M semantic memory graph (Perspectives, LinkExpressions, Neighbourhoods)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ad4m-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["ad4m", "mcp", "claude", "memory", "semantic-graph", "coasys"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
