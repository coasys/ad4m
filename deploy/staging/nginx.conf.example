# The vhost of /etc/nginx/sites-available/staging-ad4m-dev on marvin (enabled
# via sites-enabled). Installing it needs root; see deploy/staging/README.md.
# Below this header the live file matches this one line for line, the
# /internal/ block (applied 2026-09-30) and client_max_body_size (applied
# 2026-10-06) included.
# staging.ad4m.dev: staging ad4m executor for the team (coasys/ad4m #1215). Tracks origin/staging,
# redeployed by the ad4m-staging-update.timer (systemd --user, marvin). The executor listens on
# 127.0.0.1:12400 only; MCP is not exposed. The admin credential is required.
# The X-Forwarded-*/X-Real-IP headers are deliberate: once #1179 lands they mark every request
# through this proxy as a network caller, so the loopback empty-token operator never applies here.
# (Until then the executor ignores them; with the admin credential set, an empty token is not
# the operator anyway.)
# /status.json = deployed commit, written by deploy/staging/update.sh to /var/www/ad4m-staging.
server {
    listen 80;
    server_name staging.ad4m.dev;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name staging.ad4m.dev;
    ssl_certificate     /etc/letsencrypt/live/ad4m.dev-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ad4m.dev-wildcard/privkey.pem;
    add_header X-Robots-Tag "noindex, nofollow" always;
    # Let the executor enforce its own limits: 10 MB default, 50 MB for audio transcriptions
    # (rust-executor/src/api/mod.rs DefaultBodyLimit, openai_compat/router.rs). nginx default is 1 MB.
    client_max_body_size 50m;

    location = /status.json {
        root /var/www/ad4m-staging;
        add_header Cache-Control "no-cache";
        add_header Access-Control-Allow-Origin "*";
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # The executor's platform-internal routes are not for the internet.
    location /internal/ {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:12400;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }
}
