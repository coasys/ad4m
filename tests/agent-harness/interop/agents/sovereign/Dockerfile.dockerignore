# Per-Dockerfile ignore (BuildKit reads <Dockerfile>.dockerignore next to the
# Dockerfile before the context-root .dockerignore). Applied to the Sovereign
# repo context so the image never needs a .dockerignore inside that repo.
#
# Everything below rebuilds in-image; carrying host copies in breaks the build
# (host-ABI native binaries + absolute-path pnpm symlinks).

# Host installs + build output — always rebuilt inside the image.
**/node_modules
node_modules
**/dist

# git metadata — not needed to build.
.git
.gitignore

# ad4m/core build output — regenerated by build:vendor + core's build.
vendor/coasys/ad4m/core/lib

# Runtime state, certs, secrets, caches — never needed to build.
.data
.certs
.transcripts
**/playwright-report
**/test-results
**/*.log
.env
.env.local
.DS_Store
.opencode
bun.lock

# Editor / CI / docs / hooks noise — not part of the build.
.vscode
.devcontainer
.github
.husky
plans
