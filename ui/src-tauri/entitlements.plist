<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The launcher embeds a Deno/V8 runtime (the AD4M executor). Under Apple's
	  hardened runtime, which notarization requires, V8 cannot allocate
	  executable memory without these entitlements, and the app dies as soon as
	  it starts the executor.

	  The failure is quiet in exactly the wrong way: an app signed with the
	  hardened runtime and no entitlements still notarizes, still passes
	  `spctl -a -t exec`, and still passes `stapler validate`. Every check in a
	  normal signing checklist goes green and the app crashes on first launch.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>

	<!--
	  Carried over from the notarized 0.12.0 release, which was signed with it.
	  NOT yet shown to be required: the evidence is only that the shipped
	  launcher had it, not that it needs it. To settle it, once notarization is
	  unblocked: produce one signed build without it, launch it, and see whether
	  the executor still starts. If it does, drop it: the hardened runtime is
	  worth more the narrower its exceptions are.
	-->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<!--
	  Required: the executor's speech gate loads ONNX Runtime at run time on
	  macOS, Microsoft's build, downloaded into the local AI store on first use
	  (rust-executor/src/ai_service/local/onnx_runtime.rs). Library validation
	  refuses a library not signed by this app's team, and the gate stays off.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
