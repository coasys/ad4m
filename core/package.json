  "types": "lib/src/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "patch-package && tsc && pnpm run buildSchema && pnpm run bundle",
    "buildSchema": "tsx lib/src/buildSchema.js",
    "bundle": "rollup -c rollup.config.mjs",
    "test": "jest --forceExit"
  },
