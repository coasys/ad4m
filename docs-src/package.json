{
  "name": "@coasys/ad4m-docs",
  "description": "Documentation for AD4M",
  "license": "CAL-1.0",
  "homepage": "./",
  "scripts": {
    "dev": "node scripts/copy-generated.mjs && next dev",
    "start": "next start",
    "generate": "node scripts/copy-generated.mjs",
    "check:portability": "node scripts/copy-generated.mjs && node scripts/check-portability.mjs",
    "typedoc": "typedoc --options typedoc.json ../core/src",
    "build": "pnpm run check:portability && pnpm run typedoc && next build && node scripts/write-redirects.mjs",
    "check:links": "node scripts/check-links.mjs",
    "publish:pages": "pnpm run build && pnpm run check:links && rm -rf ../docs && mv out ../docs"
  },
  "dependencies": {
    "next": "^13.0.6",
    "nextra": "^2.13.4",
    "nextra-theme-docs": "^2.13.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "18.11.10",
    "typedoc": "^0.24.4",
    "typedoc-plugin-markdown": "^3.15.2",
    "typescript": "^4.9.3"
  },
  "version": "0.13.1-staging.2"
}
