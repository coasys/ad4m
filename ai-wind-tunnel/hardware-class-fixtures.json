{
  "schemaVersion": 1,
  "description": "Classifier inputs and the class each must get from hardware-classes.json. Every classifier (TS in tests/js, Rust in the executor) runs these. Memory in bytes.",
  "fixtures": [
    {
      "name": "AMD Strix Halo, 128 GB unified, ROCm and Vulkan",
      "input": { "os": "linux", "arch": "x64", "memoryBytes": 130996502528, "backends": ["cpu", "rocm", "vulkan"], "gpus": [{ "vendor": "amd", "vramBytes": 536870912, "unified": true }] },
      "expected": "amd-igpu-uma-128"
    },
    {
      "name": "AMD Strix Halo, 64 GB unified, Vulkan only",
      "input": { "os": "linux", "arch": "x64", "memoryBytes": 66571993088, "backends": ["cpu", "vulkan"], "gpus": [{ "vendor": "amd", "vramBytes": 4294967296, "unified": true }] },
      "expected": "amd-igpu-uma-64"
    },
    {
      "name": "Ryzen 780M laptop, 32 GB",
      "input": { "os": "linux", "arch": "x64", "memoryBytes": 32768000000, "backends": ["cpu", "vulkan"], "gpus": [{ "vendor": "amd", "vramBytes": 2147483648, "unified": true }] },
      "expected": "amd-igpu-uma-32"
    },
    {
      "name": "AMD iGPU on 8 GB falls to cpu",
      "input": { "os": "linux", "arch": "x64", "memoryBytes": 8000000000, "backends": ["cpu", "vulkan"], "gpus": [{ "vendor": "amd", "vramBytes": 536870912, "unified": true }] },
      "expected": "cpu-8gb"
    },
    {
      "name": "AMD iGPU without a GPU backend falls to cpu",
      "input": { "os": "linux", "arch": "x64", "memoryBytes": 33554432000, "backends": ["cpu"], "gpus": [{ "vendor": "amd", "vramBytes": 536870912, "unified": true }] },
      "expected": "cpu-32gb"
    },
    {
      "name": "RX 7900 XTX, ROCm",
      "input": { "os": "linux", "arch": "x64", "memoryBytes": 68719476736, "backends": ["cpu", "rocm", "vulkan"], "gpus": [{ "vendor": "amd", "vramBytes": 25753026560, "unified": false }] },
      "expected": "amd-dgpu-24gb"
    },
    {
      "name": "RTX 3060 12 GB, CUDA",
      "input": { "os": "linux", "arch": "x64", "memoryBytes": 33554432000, "backends": ["cpu", "cuda", "vulkan"], "gpus": [{ "vendor": "nvidia", "vramBytes": 12884901888, "unified": false }] },
      "expected": "nvidia-12gb"
    },
    {
      "name": "RTX 2060 6 GB is below the smallest nvidia class",
      "input": { "os": "linux", "arch": "x64", "memoryBytes": 16777216000, "backends": ["cpu", "cuda"], "gpus": [{ "vendor": "nvidia", "vramBytes": 6442450944, "unified": false }] },
      "expected": "cpu-16gb"
    },
    {
      "name": "RTX 4090 on Windows",
      "input": { "os": "windows", "arch": "x64", "memoryBytes": 68719476736, "backends": ["cpu", "cuda", "vulkan"], "gpus": [{ "vendor": "nvidia", "vramBytes": 25769803776, "unified": false }] },
      "expected": "nvidia-24gb"
    },
    {
      "name": "RTX 4060 Ti 16 GB, driver missing: no backend",
      "input": { "os": "linux", "arch": "x64", "memoryBytes": 34359738368, "backends": ["cpu"], "gpus": [{ "vendor": "nvidia", "vramBytes": 17179869184, "unified": false }] },
      "expected": "cpu-32gb"
    },
    {
      "name": "Laptop with an NVIDIA dGPU and an AMD iGPU picks the NVIDIA class",
      "input": { "os": "linux", "arch": "x64", "memoryBytes": 34359738368, "backends": ["cpu", "cuda", "vulkan"], "gpus": [{ "vendor": "amd", "vramBytes": 536870912, "unified": true }, { "vendor": "nvidia", "vramBytes": 8589934592, "unified": false }] },
      "expected": "nvidia-8gb"
    },
    {
      "name": "MacBook Pro M3 Max 64 GB",
      "input": { "os": "macos", "arch": "arm64", "memoryBytes": 68719476736, "backends": ["cpu", "metal"], "gpus": [{ "vendor": "apple", "vramBytes": 0, "unified": true }] },
      "expected": "apple-silicon-64"
    },
    {
      "name": "MacBook Air M2 16 GB",
      "input": { "os": "macos", "arch": "arm64", "memoryBytes": 17179869184, "backends": ["cpu", "metal"], "gpus": [{ "vendor": "apple", "vramBytes": 0, "unified": true }] },
      "expected": "apple-silicon-16"
    },
    {
      "name": "Mac mini M1 8 GB",
      "input": { "os": "macos", "arch": "arm64", "memoryBytes": 8589934592, "backends": ["cpu", "metal"], "gpus": [{ "vendor": "apple", "vramBytes": 0, "unified": true }] },
      "expected": "apple-silicon-8"
    },
    {
      "name": "Intel Mac 32 GB is a cpu class",
      "input": { "os": "macos", "arch": "x64", "memoryBytes": 34359738368, "backends": ["cpu"], "gpus": [] },
      "expected": "cpu-32gb"
    },
    {
      "name": "Headless server, 16 GB, no GPU",
      "input": { "os": "linux", "arch": "x64", "memoryBytes": 16492674416, "backends": ["cpu"], "gpus": [] },
      "expected": "cpu-16gb"
    },
    {
      "name": "Raspberry Pi 5, 8 GB",
      "input": { "os": "linux", "arch": "arm64", "memoryBytes": 8443211776, "backends": ["cpu"], "gpus": [] },
      "expected": "cpu-8gb"
    },
    {
      "name": "Workstation, 128 GB, no GPU",
      "input": { "os": "windows", "arch": "x64", "memoryBytes": 137438953472, "backends": ["cpu"], "gpus": [] },
      "expected": "cpu-128gb"
    }
  ]
}
