{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "soa://SoARelationship",
  "title": "SoARelationship",
  "description": "A typed edge between two States of Affairs. Enables epistemic, equivalence, and structural connections across SoA trees.",
  "type": "object",
  "x-ad4m": {
    "namespace": "soa://",
    "className": "SoARelationship",
    "flag": {
      "through": "soa://entry_type",
      "value": "soa://relationship"
    }
  },
  "properties": {
    "relationshipType": {
      "type": "string",
      "enum": ["supports", "contradicts", "similar", "same", "requires", "enables", "parent", "refines", "blocks"],
      "description": "The type of relationship between source and target SoA nodes",
      "x-ad4m": {
        "through": "soa://relationship_type",
        "resolveLanguage": "literal",
        "writable": true
      }
    },
    "sourceRef": {
      "type": "string",
      "description": "Reference to the source StateOfAffair (base expression URI)",
      "x-ad4m": {
        "through": "soa://relationship_source",
        "resolveLanguage": "literal",
        "writable": true
      }
    },
    "targetRef": {
      "type": "string",
      "description": "Reference to the target StateOfAffair (base expression URI)",
      "x-ad4m": {
        "through": "soa://relationship_target",
        "resolveLanguage": "literal",
        "writable": true
      }
    },
    "strength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Strength or weight of the relationship (0.0–1.0)",
      "x-ad4m": {
        "through": "soa://relationship_strength",
        "resolveLanguage": "literal",
        "writable": true
      }
    },
    "note": {
      "type": "string",
      "description": "Optional annotation explaining the relationship",
      "x-ad4m": {
        "through": "soa://relationship_note",
        "resolveLanguage": "literal",
        "writable": true
      }
    },
    "author": {
      "type": "string",
      "description": "Who asserted this relationship",
      "x-ad4m": {
        "through": "soa://relationship_author",
        "resolveLanguage": "literal",
        "writable": true
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 creation timestamp",
      "x-ad4m": {
        "through": "soa://relationship_created_at",
        "resolveLanguage": "literal",
        "writable": true
      }
    }
  },
  "required": ["relationshipType", "sourceRef", "targetRef"]
}
