{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "soa://StateOfAffair",
  "title": "StateOfAffair",
  "description": "A proposition about how things are, could be, or should be. The fundamental unit of knowledge representation in State of Affairs trees.",
  "type": "object",
  "x-ad4m": {
    "namespace": "soa://",
    "className": "StateOfAffair",
    "flag": {
      "through": "soa://entry_type",
      "value": "soa://state_of_affair"
    }
  },
  "properties": {
    "title": {
      "type": "string",
      "description": "Short summary of this state of affairs",
      "x-ad4m": {
        "through": "soa://title",
        "resolveLanguage": "literal",
        "writable": true
      }
    },
    "modality": {
      "type": "string",
      "enum": ["belief", "observation", "intention", "vision", "plan", "skill"],
      "description": "Epistemic modality — what kind of proposition this is",
      "x-ad4m": {
        "through": "soa://modality",
        "resolveLanguage": "literal",
        "writable": true
      }
    },
    "description": {
      "type": "string",
      "description": "Longer body text or explanation",
      "x-ad4m": {
        "through": "soa://description",
        "resolveLanguage": "literal",
        "writable": true
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence level (0.0–1.0). For beliefs: certainty. For intentions: commitment.",
      "x-ad4m": {
        "through": "soa://confidence",
        "resolveLanguage": "literal",
        "writable": true
      }
    },
    "status": {
      "type": "string",
      "description": "Current status. Intentions: active|completed|abandoned|blocked. Beliefs: held|revised|retracted. Observations: current|outdated.",
      "x-ad4m": {
        "through": "soa://status",
        "resolveLanguage": "literal",
        "writable": true
      }
    },
    "author": {
      "type": "string",
      "description": "Who authored/asserted this SoA (DID, agent name, or identifier)",
      "x-ad4m": {
        "through": "soa://author",
        "resolveLanguage": "literal",
        "writable": true
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 creation timestamp",
      "x-ad4m": {
        "through": "soa://created_at",
        "resolveLanguage": "literal",
        "writable": true
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 last modification timestamp",
      "x-ad4m": {
        "through": "soa://updated_at",
        "resolveLanguage": "literal",
        "writable": true
      }
    },
    "tags": {
      "type": "string",
      "description": "Comma-separated tags for categorization",
      "x-ad4m": {
        "through": "soa://tags",
        "resolveLanguage": "literal",
        "writable": true
      }
    },
    "priority": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Priority level (1=highest, 5=lowest). Mainly for intentions and plans.",
      "x-ad4m": {
        "through": "soa://priority",
        "resolveLanguage": "literal",
        "writable": true
      }
    },
    "source": {
      "type": "string",
      "description": "Evidence source — URL, file path, or description",
      "x-ad4m": {
        "through": "soa://source",
        "resolveLanguage": "literal",
        "writable": true
      }
    }
  },
  "required": ["title", "modality"]
}
