# CUDA-capable build image for AD4M CUDA builds.
# Extends the standard AD4M CI image (Ubuntu 24.04 based) with CUDA 12.5 toolkit.
# Push as: coasys/ad4m-ci-linux-cuda:latest
FROM coasys/ad4m-ci-linux:latest

USER root

# Install CUDA toolkit 12.5 (for --features cuda builds)
RUN apt-get install -y gnupg2 wget && \
    wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb && \
    dpkg -i cuda-keyring_1.1-1_all.deb && \
    rm cuda-keyring_1.1-1_all.deb && \
    apt-get update && \
    apt-get install -y cuda-toolkit-12-5 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/local/cuda-12.5/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda-12.5/lib64:${LD_LIBRARY_PATH}"

USER circleci
