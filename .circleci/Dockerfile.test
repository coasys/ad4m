# Test runner image for AD4M integration tests.
# Must be Ubuntu 25.04 (same glibc as our build host) so that pre-built
# ad4m-executor binaries run correctly.
FROM ubuntu:25.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl \
    git \
    bash \
    fuse \
    libfuse2t64 \
    ca-certificates \
    lsof \
    unzip \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Node 18 via nvm
ENV NVM_DIR=/root/.nvm
RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash \
    && . "$NVM_DIR/nvm.sh" \
    && nvm install 18 \
    && nvm alias default 18 \
    && npm install -g pnpm

ENV PATH="$NVM_DIR/versions/node/v18.20.8/bin:$PATH"

# Install Deno (used by language bundles)
RUN curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh

# Create workspace dir
WORKDIR /workspace
