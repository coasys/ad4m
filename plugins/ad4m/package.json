{
  "name": "@coasys/openclaw-ad4m",
  "version": "0.0.2",
  "description": "OpenClaw plugin for AD4M — bridges AD4M's MCP tools as native agent tools and turns subscriptions into waker events",
  "license": "MIT",
  "main": "dist/index.cjs",
  "openclaw": {
    "extensions": ["./dist/index.cjs"]
  },
  "files": ["dist", "openclaw.plugin.json", "skills", "README.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/coasys/ad4m",
    "directory": "plugins/ad4m"
  },
  "keywords": ["openclaw", "ad4m", "mcp", "p2p", "holochain", "neighbourhoods"],
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/index.cjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@coasys/ad4m": "0.13.0-test-6"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "vitest": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
