{
  "id": "ad4m-openclaw-plugin",
  "name": "AD4M",
  "description": "Connect to AD4M — join P2P neighbourhoods, message humans and other AI agents, watch for changes in real-time. Bridges AD4M's MCP server into OpenClaw as native agent tools.",
  "version": "0.1.0",
  "skills": ["skills/ad4m"],
  "configSchema": {
    "type": "object",
    "properties": {
      "mcpEndpoint": {
        "type": "string",
        "default": "http://localhost:3001/mcp",
        "description": "AD4M executor MCP endpoint URL"
      },
      "adminCredential": {
        "type": "string",
        "description": "Admin credential for the AD4M executor (used as Bearer token)"
      },
      "toolRefreshIntervalMs": {
        "type": "number",
        "default": 30000,
        "description": "How often to poll for new dynamic SHACL tools (ms)"
      },
      "wakerEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable the embedded AD4M waker service"
      },
      "executorWsUrl": {
        "type": "string",
        "default": "ws://localhost:12100/graphql",
        "description": "AD4M executor GraphQL WebSocket URL for waker subscriptions"
      },
      "wakeUrl": {
        "type": "string",
        "default": "http://localhost:18789/hooks/wake",
        "description": "OpenClaw wake endpoint URL"
      },
      "wakeToken": {
        "type": "string",
        "description": "Bearer token for the OpenClaw wake endpoint"
      },
      "debounceMs": {
        "type": "number",
        "default": 2000,
        "description": "Debounce interval for wake events (ms)"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "uiHints": {
    "mcpEndpoint": {
      "label": "MCP Endpoint",
      "placeholder": "http://localhost:3001/mcp"
    },
    "adminCredential": {
      "label": "Admin Credential",
      "sensitive": true
    },
    "toolRefreshIntervalMs": {
      "label": "Tool Refresh Interval (ms)",
      "placeholder": "30000"
    },
    "executorWsUrl": {
      "label": "Executor WebSocket URL",
      "placeholder": "ws://localhost:12100/graphql"
    },
    "wakeUrl": {
      "label": "Wake Endpoint URL",
      "placeholder": "http://localhost:18789/hooks/wake"
    },
    "wakeToken": {
      "label": "Wake Token",
      "sensitive": true
    },
    "debounceMs": {
      "label": "Debounce (ms)",
      "placeholder": "2000"
    }
  }
}
