{
  "name": "@coasys/link-server",
  "version": "0.1.0",
  "description": "Self-hostable link language server for AD4M — communities run their own data",
  "type": "module",
  "bin": {
    "link-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/websocket": "^11.0.0",
    "better-sqlite3": "^13.0.0",
    "@noble/ed25519": "^2.1.0",
    "@noble/curves": "^1.6.0",
    "@noble/ciphers": "^1.0.0",
    "jose": "^5.9.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ws": "^8.5.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.1": true
  }
}
